{
  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO indicator (kind, value)\n        VALUES ($1, $2)\n        ON CONFLICT (kind, value) DO UPDATE SET value = EXCLUDED.value\n        RETURNING id, (xmax = 0) AS \"inserted!\"\n        ",
