{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            i.value AS matched_value,\n            iorr.source,\n            iorr.confidence,\n            iorr.first_seen,\n            iorr.last_seen,\n            r.id AS \"report_id?\",\n            r.title AS report_title,\n            r.url AS report_url\n        FROM indicator i\n        JOIN indicator_observed_in_report iorr ON iorr.indicator_id = i.id\n        JOIN report r ON r.id = iorr.report_id\n        WHERE i.kind = 'path' AND $1 ILIKE '%' || i.value || '%'\n        ",
