{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            r.raw ->> 'file_name' AS matched_value,\n            r.source,\n            r.id AS report_id,\n            r.title AS report_title,\n            r.url AS report_url\n        FROM report r\n        WHERE lower(r.raw ->> 'file_name') = lower($1)\n        LIMIT 20\n        ",
